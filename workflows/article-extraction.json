      "id": "325252ba-c7b4-471c-b4a7-8971ae3da3b6",
      "name": "擷取模擬文章"
    },
    {
      "parameters": {
        "jsCode": "const articles = $input.all();\n\nreturn articles.map((item) => {\n  const originalContent = item.json.content ?? '';\n\n  // 移除 HTML 標籤，再整理多餘空白\n  const cleanedContent = String(originalContent)\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  return {\n    json: {\n      ...item.json,\n      cleaned_content: cleanedContent,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "d19c1b8e-5756-4326-94ca-6fea0ed84068",
      "name": "清理文章內容"
    },
    {
      "parameters": {
        "jsCode": "const articles = $input.all();\n\nreturn articles.map((item) => {\n  const content = String(item.json.cleaned_content ?? '');\n  let category = '其他';\n\n  if (content.includes('自動化')) {\n    category = '流程自動化';\n  } else if (content.includes('專案管理')) {\n    category = '團隊協作';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      category,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "5332add4-fbc1-469d-be1c-3750adc79972",
      "name": "分類文章"
    },
